# Server Port
PORT=8080

# Active Spring Profile (mysql or dev)
SPRING_PROFILES_ACTIVE=mysql

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce_auth_db
DB_USERNAME=root
DB_PASSWORD=root

# Security & JWT Configuration
# Generate a 256-bit+ secure random secret in production
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000

# Client Configuration & CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# SMTP Mail Server (Optional for production email dispatch)
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-email@gmail.com
# SPRING_MAIL_PASSWORD=your-app-password
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
